#!/usr/bin/env bash
# Generated by setup.sh. Paths are resolved at runtime, so the checkout is movable.
set -Eeuo pipefail
ROOT=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
HOST=${HOST:-127.0.0.1}
PORT=${PORT:-8000}
SERVED_MODEL_NAME=${SERVED_MODEL_NAME:-${SERVED_NAME:-big}}
BATCH=${BATCH:-0}
MEM_BUDGET_MB=${MEM_BUDGET_MB:-110000}
MODEL_FILE=${MODEL_FILE:-"$ROOT/weights/DeepSeek-V4.1-Flash-vq8sh14-q4k-mtpnative.gguf"}
ENGRAM_DIR=${ENGRAM_DIR:-"$ROOT/engram"}
# Set ZCHAIN_DIR='' explicitly to run without a domain sidecar.
ZCHAIN_DIR=${ZCHAIN_DIR-"$ROOT/weights/DeepSeek-V4.1-Flash-vq8sh14-q4k-mtpnative-grrb-code_fit_n15360-engine"}
DRY_RUN=0
if [[ ${1:-} == -h || ${1:-} == --help ]]; then
    cat <<'HELP'
Usage: ./run.sh [--dry-run] [additional ds4-server options...]
Environment: HOST=127.0.0.1 PORT=8000 SERVED_MODEL_NAME=big BATCH=0
             MEM_BUDGET_MB=110000 MODEL_FILE=... ENGRAM_DIR=... ZCHAIN_DIR=...
PORT=8001 SERVED_MODEL_NAME=coder BATCH=2 ./run.sh
./run.sh --served-model-name coder --port 8001
ZCHAIN_DIR='' disables the sidecar. Ctrl+C stops the foreground server.
--dry-run prints the command without requiring the binary or any weights.
No service, detached process, automatic update or download is started.
HELP
    exit 0
fi
if [[ ${1:-} == --dry-run ]]; then DRY_RUN=1; shift; fi
[[ "$PORT" =~ ^[0-9]{1,5}$ ]] && ((10#$PORT >= 1 && 10#$PORT <= 65535)) || {
    echo 'PORT must be 1..65535.' >&2; exit 2;
}
[[ "$BATCH" =~ ^[0-8]$ ]] || { echo 'BATCH must be 0..8.' >&2; exit 2; }
[[ "$MEM_BUDGET_MB" =~ ^[1-9][0-9]*$ ]] || { echo 'MEM_BUDGET_MB must be positive.' >&2; exit 2; }
[[ "$SERVED_MODEL_NAME" =~ ^[A-Za-z0-9._/:-]{1,200}$ ]] || {
    echo 'Invalid SERVED_MODEL_NAME: use 1..200 URL-safe model ID characters.' >&2; exit 2;
}
source "$ROOT/scripts/local-env.sh"
youngai_local_env
cd -- "$ROOT"
MODEL_FILE=$(youngai_local_path "$MODEL_FILE")
ENGRAM_DIR=$(youngai_local_path "$ENGRAM_DIR")
if [[ -n "$ZCHAIN_DIR" ]]; then ZCHAIN_DIR=$(youngai_local_path "$ZCHAIN_DIR"); fi
args=("$ROOT/bin/ds4-server" --cuda -m "$MODEL_FILE" --engram-dir "$ENGRAM_DIR"
      --host "$HOST" --port "$PORT" --served-model-name "$SERVED_MODEL_NAME"
      --batch "$BATCH" --mem-budget-mb "$MEM_BUDGET_MB")
if [[ -n "$ZCHAIN_DIR" ]]; then args+=(--zchain "$ZCHAIN_DIR"); fi
args+=("$@")
if (( DRY_RUN )); then printf '%q ' "${args[@]}"; printf '\n'; exit 0; fi
[[ -x "$ROOT/bin/ds4-server" ]] || { echo 'Run bash setup.sh to build the server first.' >&2; exit 1; }
[[ -s "$MODEL_FILE" ]] || { printf 'Missing model: %s\n' "$MODEL_FILE" >&2; exit 1; }
for shard in model-00047-of-00048.safetensors model-00048-of-00048.safetensors; do
    [[ -s "$ENGRAM_DIR/$shard" ]] || { printf 'Missing Engram shard: %s/%s\n' "$ENGRAM_DIR" "$shard" >&2; exit 1; }
done
if [[ -n "$ZCHAIN_DIR" && ! -d "$ZCHAIN_DIR" ]]; then
    printf 'Missing sidecar: %s (set ZCHAIN_DIR="" to disable)\n' "$ZCHAIN_DIR" >&2
    exit 1
fi
# Foreground exec preserves signals and exit status. Redirect output explicitly
# to logs/server.log when needed; no hidden daemon or watchdog is installed.
exec "${args[@]}"
